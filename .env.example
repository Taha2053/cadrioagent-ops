# Service 1 provider: ollama or deepseek
LLM_PROVIDER=ollama

# Local Ollama running on the Docker host
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct

# DeepSeek OpenAI-compatible API. Intentionally empty; add your key locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_REQUEST_TIMEOUT_SECONDS=180

# Service 3 and MLflow
AUDIO_MODEL_PATH=vault/models/cardio_model.onnx
MLFLOW_TRACKING_ENABLED=true
MLFLOW_EXPERIMENT_NAME=cardioagent-audio-inference

# API Gateway host port (default 8000; change to e.g. 8080 if 8000 is occupied)
API_GATEWAY_PORT=8000

# Optional gateway protection. Empty means local-only access without a key.
API_KEY=
# Explicitly opt in to external processing in EACH analysis request as well.
RAG_SCORE_THRESHOLD=0.55
# Host-side training/evaluation. Compose uses its internal service URL.
MLFLOW_TRACKING_URI=http://localhost:5000
